{
  "name": "timenote",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @timenote/web dev",
    "dev:desktop": "pnpm --filter @timenote/desktop tauri:dev",
    "dev:ext": "pnpm --filter @timenote/extension dev",
    "dev:cli": "pnpm tsx apps/cli/src/main.ts",
    "build": "pnpm --filter @timenote/web build",
    "build:ext": "pnpm --filter @timenote/extension build",
    "build:desktop": "pnpm --filter @timenote/desktop tauri:build",
    "install:desktop:local": "pnpm --filter @timenote/desktop tauri:build:app && rm -rf /Applications/TimeNote.app && cp -R apps/desktop/src-tauri/target/release/bundle/macos/TimeNote.app /Applications/",
    "deploy:web": "pnpm --filter @timenote/web run deploy",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run --config packages/core/vitest.config.ts",
    "test:ui": "vitest run --config packages/ui/vitest.config.ts",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.12",
    "typescript": "^5.9.2",
    "vitest": "^4.0.18"
  },
  "packageManager": "pnpm@12.4.2+sha512.08adc6613180275c7c9edada39dcf08c9c61ad4e7eaf330a4f3461f102b0f907423454d117f98e72d47fef0616070644d7bffc973a6a57f5090a6d7c368b07c9"
}
